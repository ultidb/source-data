# source-data scraper configuration.
#
# Copy to .env and fill in. Every field here is read by SecretsConfig in
# config.py; real environment variables take precedence over this file.
#
#     cp .env.example .env

# --- Ingest API -----------------------------------------------------------

# Base URL of the ultidb API, no trailing slash. Used by `scrape --post`,
# `post-documents`, and the app.py scheduler. Both commands also accept
# --api-url, which wins over this.
API_URL=http://localhost:3030

# Shared secret sent as the X-Ingest-Token header on POST /v2/ingest. This
# must match what the API has: docker-compose passes INGEST_TOKEN through to
# the api service, and per-source overrides (INGEST_TOKEN_USAU /
# INGEST_TOKEN_WFDF) take precedence there if set.
#
# The API answers 503 when it has no token configured at all, and 401 when
# yours does not match. Any value works locally.
INGEST_TOKEN=local-dev-ingest-token

# Post freshly scraped data to API_URL from the app.py background scheduler.
# Leave false for local scraping so you do not write to a real API by accident.
POST_TO_API=false

# --- Scraper behaviour ----------------------------------------------------

# Commit and push scraped output to the source-data `live` branch. The
# production ingest path depends on this push; leave false locally.
COMMIT_AND_PUSH=false

# Scrape the USAU calendar on app.py startup rather than waiting for the job.
LOAD_CAL_ON_START=false

# Bind address for `scraper serve`.
HOST=0.0.0.0

# --- Video scraping (optional) --------------------------------------------
# Only needed for `scraper videos`. Leave blank to skip video ingestion.

YOUTUBE_API_KEY=
VIMEO_CLIENT_ID=
VIMEO_CLIENT_SECRET=
VIMEO_ACCESS_TOKEN=
